rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function pad2(value) { return value < 10 ? '0' + string(value) : string(value); }
  function slDate(value) { let t = value + duration.value(330,'m'); return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()); }
  function slWeek(value) { let t = value + duration.value(330,'m'); let monday = t - duration.value((t.dayOfWeek() + 6) % 7,'d'); return string(monday.year()) + '-' + pad2(monday.month()) + '-' + pad2(monday.day()); }
  function slMonth(value) { let t = value + duration.value(330,'m'); return string(t.year()) + '-' + pad2(t.month()); }
  function blockPath(uid) { return /databases/$(database)/documents/accountBlocks/$(uid); }
  // A blocked Auth identity cannot read/write application data. A block is created
  // atomically before the person's profile and ranking are removed.
  function logged() { return request.auth != null && !exists(blockPath(request.auth.uid)); }
  function mine(uid) { return logged() && request.auth.uid == uid; }
  function admin() { return logged() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
  function validOutlet(o) { return o in ['Akuressa','Aluthgama','Ambalangoda','Embilipitiya','Galle','Karapitiya','Matara','Matara 02','Megalle','Monaragala','Tangalle','Unawatuna','Welipenna A','Welipenna B','Other']; }
  function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
  function eventPath(id) { return /databases/$(database)/documents/scoreEvents/$(id); }
  function keyPath(id) { return /databases/$(database)/documents/answerKeys/$(id); }
  function claimPath(id) { return /databases/$(database)/documents/rankedClaims/$(id); }
  function usernamePath(id) { return /databases/$(database)/documents/usernames/$(id); }
  function profileEdit() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','usernameLower','avatar','updatedAt'])
      && request.resource.data.username is string
      && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 24
      && request.resource.data.usernameLower is string
      && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 25000
      && getAfter(usernamePath(request.resource.data.usernameLower)).data.uid == request.auth.uid;
  }
  function scoringUpdate(uid) {
    let id = request.resource.data.lastEventId;
    let e = getAfter(eventPath(id)).data;
    let credit=e.get('outletCredit',e.points);
    return id is string && id.size() <= 210
      && !exists(eventPath(id))
      && e.uid == uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['lastEventId','totalPoints','totalAnswers','weeklyPoints','monthlyPoints','outletPoints','outletWeeklyPoints','outletMonthlyPoints','outletAnswers','outletWeeklyAnswers','outletMonthlyAnswers','correctAnswers','dailyActivity','rapidCorrectStreak','reviewSuggested','updatedAt'])
      && request.resource.data.totalPoints == resource.data.totalPoints + e.points
      && request.resource.data.totalAnswers == resource.data.totalAnswers + 1
      && request.resource.data.correctAnswers == resource.data.get('correctAnswers',0) + (e.points > 0 ? 1 : 0)
      && request.resource.data.dailyActivity.diff(resource.data.get('dailyActivity',{})).affectedKeys().hasOnly([e.activityDay])
      && request.resource.data.dailyActivity[e.activityDay] == resource.data.get('dailyActivity',{}).get(e.activityDay,0) + 1
      && request.resource.data.rapidCorrectStreak == (e.points >= 68 ? resource.data.get('rapidCorrectStreak',0) + 1 : 0)
      && request.resource.data.reviewSuggested == (resource.data.get('reviewSuggested',false) || request.resource.data.rapidCorrectStreak >= 7)
      && request.resource.data.weeklyPoints.diff(resource.data.get('weeklyPoints',{})).affectedKeys().hasOnly([e.weekKey])
      && request.resource.data.weeklyPoints[e.weekKey] == resource.data.get('weeklyPoints',{}).get(e.weekKey,0) + e.points
      && request.resource.data.monthlyPoints.diff(resource.data.get('monthlyPoints',{})).affectedKeys().hasOnly([e.monthKey])
      && request.resource.data.monthlyPoints[e.monthKey] == resource.data.get('monthlyPoints',{}).get(e.monthKey,0) + e.points
      && request.resource.data.outletPoints.diff(resource.data.get('outletPoints',{})).affectedKeys().hasOnly([e.outlet])
      && request.resource.data.outletPoints[e.outlet] == resource.data.get('outletPoints',{}).get(e.outlet,0) + credit
      && request.resource.data.outletWeeklyPoints.diff(resource.data.get('outletWeeklyPoints',{})).affectedKeys().hasOnly([e.outletWeekKey])
      && request.resource.data.outletWeeklyPoints[e.outletWeekKey] == resource.data.get('outletWeeklyPoints',{}).get(e.outletWeekKey,0) + credit
      && request.resource.data.outletMonthlyPoints.diff(resource.data.get('outletMonthlyPoints',{})).affectedKeys().hasOnly([e.outletMonthKey])
      && request.resource.data.outletMonthlyPoints[e.outletMonthKey] == resource.data.get('outletMonthlyPoints',{}).get(e.outletMonthKey,0) + credit
      && request.resource.data.outletMonthlyAnswers.diff(resource.data.get('outletMonthlyAnswers',{})).affectedKeys().hasOnly([e.outletMonthKey])
      && request.resource.data.outletMonthlyAnswers[e.outletMonthKey] == resource.data.get('outletMonthlyAnswers',{}).get(e.outletMonthKey,0) + 1
      && request.resource.data.outletAnswers.diff(resource.data.get('outletAnswers',{})).affectedKeys().hasOnly([e.outlet])
      && request.resource.data.outletAnswers[e.outlet] == resource.data.get('outletAnswers',{}).get(e.outlet,0) + 1
      && request.resource.data.outletWeeklyAnswers.diff(resource.data.get('outletWeeklyAnswers',{})).affectedKeys().hasOnly([e.outletWeekKey])
      && request.resource.data.outletWeeklyAnswers[e.outletWeekKey] == resource.data.get('outletWeeklyAnswers',{}).get(e.outletWeekKey,0) + 1;
  }
  match /admins/{uid} { allow get: if mine(uid) || admin(); allow list: if false; allow write: if false; }
  match /usernames/{name} {
    allow get: if true;
    allow list: if false;
    allow create: if logged() && name.matches('^[a-z0-9._-]{3,24}$')
      && request.resource.data.keys().hasOnly(['uid','authEmail'])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.authEmail == request.auth.token.email
      && getAfter(userPath(request.auth.uid)).data.usernameLower == name;
    allow delete: if (logged() && resource.data.uid == request.auth.uid
      && getAfter(userPath(request.auth.uid)).data.usernameLower != name)
      || (admin() && getAfter(blockPath(resource.data.uid)).data.uid == resource.data.uid);
    allow update: if false;
  }
  function resetScoresOnly() {
    let d=request.resource.data;
    return admin() && d.scoreResetAt == request.time && d.updatedAt == request.time
      && d.diff(resource.data).affectedKeys().hasOnly(['totalPoints','totalAnswers','correctAnswers','lastEventId','dailyActivity','rapidCorrectStreak','reviewSuggested','weeklyPoints','monthlyPoints','outletPoints','outletWeeklyPoints','outletMonthlyPoints','outletAnswers','outletWeeklyAnswers','outletMonthlyAnswers','scoreResetAt','updatedAt'])
      && d.totalPoints == 0 && d.totalAnswers == 0 && d.correctAnswers == 0
      && d.lastEventId == '' && d.dailyActivity == {} && d.rapidCorrectStreak == 0 && d.reviewSuggested == false
      && d.weeklyPoints == {} && d.monthlyPoints == {} && d.outletPoints == {} && d.outletWeeklyPoints == {} && d.outletMonthlyPoints == {}
      && d.outletAnswers == {} && d.outletWeeklyAnswers == {} && d.outletMonthlyAnswers == {};
  }
  function adminOutletChange(before, after) {
    return admin() && validOutlet(after.outlet) && before.outlet != after.outlet
      && after.diff(before).affectedKeys().hasOnly(['outlet','updatedAt','outletPoints','outletWeeklyPoints','outletMonthlyPoints'])
      && outletBalancesOnly(before,after);
  }
  function outletBalancesOnly(before,after) {
    let old = before.get('outletPoints',{});
    let next = after.get('outletPoints',{});
    return next.diff(old).affectedKeys().hasOnly([before.outlet])
      && (next == old || next.get(before.outlet,-1) == 0)
      && after.get('outletWeeklyPoints',{}) is map && after.get('outletMonthlyPoints',{}) is map;
  }
  function archivePath(uid) { return /databases/$(database)/documents/outletRankArchives/$(uid); }
  match /outletRankArchives/{uid} {
    allow get: if mine(uid) || admin();
    allow delete: if admin();
    allow create, update: if mine(uid) && getAfter(userPath(uid)).data.outlet == 'Other'
      && request.resource.data.outlet == 'Other' && !(request.resource.data.name.lower() in ['indika','udaya'])
      && request.resource.data.name == getAfter(userPath(uid)).data.username && !admin()
      && publicFieldsOk(uid) && publicIncrement(resource == null ? zeroRank() : resource.data,uid);
    allow create, update: if admin() && getAfter(userPath(uid)).data.outlet == 'Other'
      && request.resource.data.diff(get(/databases/$(database)/documents/publicRanks/$(uid)).data).affectedKeys().hasOnly(['outletPoints','outletWeeklyPoints','outletMonthlyPoints'])
      && outletBalancesOnly(get(/databases/$(database)/documents/publicRanks/$(uid)).data,request.resource.data);
  }
  function restorePublicRank(uid) {
    let person=getAfter(userPath(uid)).data;
    let saved=get(archivePath(uid)).data;
    let role=/databases/$(database)/documents/admins/$(uid);
    return admin() && get(userPath(uid)).data.outlet == 'Other' && person.outlet != 'Other'
      && !(person.usernameLower in ['indika','udaya']) && (!exists(role) || !get(role).data.enabled)
      && request.resource.data.diff(saved).affectedKeys().hasOnly(['outlet','name','avatar','updatedAt'])
      && request.resource.data.outlet == person.outlet && request.resource.data.name == person.username
      && request.resource.data.avatar == person.avatar && saved.get('scoreResetAt',null) == person.get('scoreResetAt',null);
  }
  match /users/{uid} {
    allow read: if mine(uid) || admin();
    allow create: if mine(uid)
      && !request.resource.data.keys().hasAny(['outletHistory','outletSince','outletResetTimes','scoreResetAt'])
      && request.resource.data.keys().hasAll(['uid','username','usernameLower','outlet','avatar','totalPoints','totalAnswers','weeklyPoints','monthlyPoints','outletPoints','outletWeeklyPoints','outletMonthlyPoints','outletAnswers','outletWeeklyAnswers','outletMonthlyAnswers','correctAnswers','dailyActivity','rapidCorrectStreak','reviewSuggested','lastEventId','createdAt','updatedAt'])
      && request.resource.data.uid == uid
      && validOutlet(request.resource.data.outlet)
      && request.resource.data.username is string
      && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 24
      && request.resource.data.avatar == ''
      && request.resource.data.totalPoints == 0 && request.resource.data.totalAnswers == 0
      && request.resource.data.correctAnswers == 0 && request.resource.data.dailyActivity == {}
      && request.resource.data.rapidCorrectStreak == 0 && request.resource.data.reviewSuggested == false
      && request.resource.data.weeklyPoints == {} && request.resource.data.monthlyPoints == {}
      && request.resource.data.outletPoints == {} && request.resource.data.outletWeeklyPoints == {} && request.resource.data.outletMonthlyPoints == {} && request.resource.data.outletMonthlyAnswers == {}
      && request.resource.data.outletAnswers == {} && request.resource.data.outletWeeklyAnswers == {}
      && request.resource.data.lastEventId == ''
      && getAfter(usernamePath(request.resource.data.usernameLower)).data.uid == uid;
    allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasAny(['scoreResetAt']) && resetScoresOnly()) || (mine(uid) && (profileEdit() || scoringUpdate(uid)))
      || (admin() && validOutlet(request.resource.data.outlet) && resource.data.outlet != request.resource.data.outlet
        && request.resource.data.outletSince == request.time && request.resource.data.outletHistory is map
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outlet','updatedAt','outletSince','outletHistory','outletResetTimes','outletPoints','outletWeeklyPoints','outletMonthlyPoints'])
        && outletBalancesOnly(resource.data,request.resource.data))
      || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewSuggested','updatedAt'])
      && request.resource.data.reviewSuggested == false);
    // Delete only after a permitted admin has simultaneously blocked the UID.
    allow delete: if admin() && request.auth.uid != uid
      && !exists(/databases/$(database)/documents/admins/$(uid))
      && resource.data.usernameLower != 'indika' && resource.data.usernameLower != 'udaya'
      && getAfter(blockPath(uid)).data.uid == uid;
  }
  // Unlike /users, only eligible ranked accounts are visible to other players.
  function allowedToPublish(uid, name, outlet) {
    return mine(uid) && outlet != 'Other'
      && name.lower() != 'indika' && name.lower() != 'udaya'
      && !admin()
      && getAfter(userPath(uid)).data.outlet != 'Other'
      && getAfter(userPath(uid)).data.username == name
      && getAfter(userPath(uid)).data.outlet == outlet;
  }
  function publicEvent(uid) {
    return getAfter(eventPath(request.resource.data.lastEventId)).data;
  }
  function validBucket(prev,field,key,points) {
    let old=prev.get(field,{});
    let next=request.resource.data.get(field,{});
    let before=old.get(key,{'answered':0,'correct':0});
    let after=next.get(key,{});
    return (!(field in request.resource.data)) ||
      (next.diff(old).affectedKeys().hasOnly([key]) && after.keys().hasOnly(['answered','correct'])
       && after.answered == before.answered+1 && after.correct == before.correct+(points>0?1:0));
  }
  function publicFieldsOk(uid) {
    let e=publicEvent(uid);
    return request.resource.data.keys().hasAll(['uid','name','outlet','avatar','lastEventId','totalPoints','weeklyPoints','monthlyPoints','outletPoints','outletWeeklyPoints','outletMonthlyPoints','outletAnswers','outletWeeklyAnswers','outletMonthlyAnswers','correctAnswers','dailyActivity','updatedAt'])
      && request.resource.data.keys().hasOnly(['scoreResetAt','outletAccuracy','weeklyAccuracy','uid','name','outlet','avatar','lastEventId','totalPoints','weeklyPoints','monthlyPoints','outletPoints','outletWeeklyPoints','outletMonthlyPoints','outletAnswers','outletWeeklyAnswers','outletMonthlyAnswers','correctAnswers','dailyActivity','updatedAt'])
      && request.resource.data.uid == uid
      && request.resource.data.get('scoreResetAt',null) == getAfter(userPath(uid)).data.get('scoreResetAt',null)
      && request.resource.data.avatar == getAfter(userPath(uid)).data.avatar
      && request.resource.data.lastEventId == getAfter(userPath(uid)).data.lastEventId
      && e.uid == uid
      && e.outlet != 'Other'
      && e.points >= 0 && e.points <= 70;
  }
  function publicIncrement(prev, uid) {
    let e=publicEvent(uid);
    let credit=e.get('outletCredit',e.points);
    return validBucket(prev,'outletAccuracy',e.outlet,e.points) && validBucket(prev,'weeklyAccuracy',e.outletWeekKey,e.points)
      && !exists(eventPath(request.resource.data.lastEventId))
      && request.resource.data.totalPoints == prev.totalPoints + e.points
      && request.resource.data.correctAnswers == prev.get('correctAnswers',0) + (e.points > 0 ? 1 : 0)
      && request.resource.data.dailyActivity.diff(prev.get('dailyActivity',{})).affectedKeys().hasOnly([e.activityDay])
      && request.resource.data.dailyActivity[e.activityDay] == prev.get('dailyActivity',{}).get(e.activityDay,0) + 1
      && request.resource.data.weeklyPoints.diff(prev.get('weeklyPoints',{})).affectedKeys().hasOnly([e.weekKey])
      && request.resource.data.weeklyPoints[e.weekKey] == prev.get('weeklyPoints',{}).get(e.weekKey, 0) + e.points
      && request.resource.data.monthlyPoints.diff(prev.get('monthlyPoints',{})).affectedKeys().hasOnly([e.monthKey])
      && request.resource.data.monthlyPoints[e.monthKey] == prev.get('monthlyPoints',{}).get(e.monthKey, 0) + e.points
      && request.resource.data.outletPoints.diff(prev.get('outletPoints',{})).affectedKeys().hasOnly([e.outlet])
      && request.resource.data.outletPoints[e.outlet] == prev.get('outletPoints',{}).get(e.outlet, 0) + credit
      && request.resource.data.outletWeeklyPoints.diff(prev.get('outletWeeklyPoints',{})).affectedKeys().hasOnly([e.outletWeekKey])
      && request.resource.data.outletWeeklyPoints[e.outletWeekKey] == prev.get('outletWeeklyPoints',{}).get(e.outletWeekKey, 0) + credit
      && request.resource.data.outletMonthlyPoints.diff(prev.get('outletMonthlyPoints',{})).affectedKeys().hasOnly([e.outletMonthKey])
      && request.resource.data.outletMonthlyPoints[e.outletMonthKey] == prev.get('outletMonthlyPoints',{}).get(e.outletMonthKey, 0) + credit
      && request.resource.data.outletAnswers.diff(prev.get('outletAnswers',{})).affectedKeys().hasOnly([e.outlet])
      && request.resource.data.outletAnswers[e.outlet] == prev.get('outletAnswers',{}).get(e.outlet, 0) + 1
      && request.resource.data.outletWeeklyAnswers.diff(prev.get('outletWeeklyAnswers',{})).affectedKeys().hasOnly([e.outletWeekKey])
      && request.resource.data.outletWeeklyAnswers[e.outletWeekKey] == prev.get('outletWeeklyAnswers',{}).get(e.outletWeekKey, 0) + 1
      && request.resource.data.outletMonthlyAnswers.diff(prev.get('outletMonthlyAnswers',{})).affectedKeys().hasOnly([e.outletMonthKey])
      && request.resource.data.outletMonthlyAnswers[e.outletMonthKey] == prev.get('outletMonthlyAnswers',{}).get(e.outletMonthKey, 0) + 1;
  }
  function zeroRank() {
    return {
      'totalPoints':0, 'weeklyPoints':{}, 'monthlyPoints':{},
      'outletPoints':{}, 'outletWeeklyPoints':{}, 'outletMonthlyPoints':{},
      'outletAnswers':{}, 'outletWeeklyAnswers':{}, 'outletMonthlyAnswers':{},
      'correctAnswers':0, 'dailyActivity':{}
    };
  }
  // Self-observed history is display-only, not an authoritative score or reward.
  match /rankHistory/{uid} {
    allow get: if logged();
    allow list: if false;
    allow create, update: if mine(uid)
      && exists(/databases/$(database)/documents/publicRanks/$(uid))
      && request.resource.data.keys().hasOnly(['uid','bestRank','updatedAt'])
      && request.resource.data.uid == uid
      && request.resource.data.bestRank is int
      && request.resource.data.bestRank >= 1
      && request.resource.data.updatedAt == request.time
      && (!exists(/databases/$(database)/documents/rankHistory/$(uid))
        || request.resource.data.bestRank <= resource.data.bestRank);
    allow delete: if admin();
  }
  match /publicRanks/{uid} {
    allow read: if logged();
    allow create: if allowedToPublish(uid, request.resource.data.name, request.resource.data.outlet)
      && publicFieldsOk(uid)
      && publicIncrement(zeroRank(), uid) || (admin() && restorePublicRank(uid));
    allow update: if (allowedToPublish(uid, request.resource.data.name, request.resource.data.outlet)
      && publicFieldsOk(uid)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outletAccuracy','weeklyAccuracy','lastEventId','totalPoints','weeklyPoints','monthlyPoints','outletPoints','outletWeeklyPoints','outletMonthlyPoints','outletAnswers','outletWeeklyAnswers','outletMonthlyAnswers','correctAnswers','dailyActivity','updatedAt','name','avatar'])
      && publicIncrement(resource.data, uid))
      || (mine(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar','updatedAt'])
        && request.resource.data.name == getAfter(userPath(uid)).data.username
        && request.resource.data.avatar == getAfter(userPath(uid)).data.avatar
        && getAfter(userPath(uid)).data.outlet != 'Other'
        && request.resource.data.name.lower() != 'indika'
        && request.resource.data.name.lower() != 'udaya'
        && !admin())
      || (adminOutletChange(resource.data,request.resource.data)
        && request.resource.data.outlet == getAfter(userPath(uid)).data.outlet
        && request.resource.data.outlet != 'Other');
    allow delete: if admin() || (mine(uid) && (getAfter(userPath(uid)).data.usernameLower in ['indika','udaya'] || getAfter(userPath(uid)).data.outlet == 'Other'));
  }
  // Account-removal tombstones are admin-only writes. No browser account may
  // remove its own tombstone or delete an administrator.
  match /accountBlocks/{uid} {
    allow get: if (request.auth != null && request.auth.uid == uid) || admin();
    allow list: if admin();
    allow create: if admin()
      && request.auth.uid != uid
      && exists(userPath(uid))
      && !exists(/databases/$(database)/documents/admins/$(uid))
      && get(userPath(uid)).data.usernameLower != 'indika'
      && get(userPath(uid)).data.usernameLower != 'udaya'
      && request.resource.data.keys().hasOnly(['uid','username','blockedBy','blockedAt','reason'])
      && request.resource.data.uid == uid
      && request.resource.data.username == get(userPath(uid)).data.username
      && request.resource.data.blockedBy == request.auth.uid
      && request.resource.data.blockedAt == request.time
      && request.resource.data.reason == 'admin_removed';
    allow update, delete: if false;
  }
  // Permission-only health probes: no stored document or answer-key value is
  // exposed. A successful get of a missing probe document is intentional.
  match /syncChecks/{id} {
    allow get: if logged() && id in ['daily-v4714','arena-v4717'];
    allow list, create, update, delete: if false;
  }
  match /syncKeyChecks/{id} {
    allow get: if logged()
      && id.matches('^(past2024|questions|paper1|paper2|paper3)_[0-9]{1,2}$')
      && exists(keyPath(id));
    allow list, create, update, delete: if false;
  }
  match /answerKeys/{id} {
    allow read: if false;
    allow write: if admin() && get(userPath(request.auth.uid)).data.usernameLower == 'udaya'
      && request.resource.data.keys().hasOnly(['answer','paper','index'])
      && request.resource.data.answer is int && request.resource.data.answer >= 0 && request.resource.data.answer <= 5;
  }
  // Legacy paper claims are immutable history; updated clients write daily
  // question events instead. Keep old reads for safe migration and retries.
  match /rankedClaims/{id} {
    allow get: if logged() && id.matches('^' + request.auth.uid + '_.*');
    allow list, create, update, delete: if false;
  }
  function questionKey(paper,index) {
    return paper == 'questions' && index == 14 ? 'past2024_22'
      : paper == 'paper1' && index == 9 ? 'questions_7' : paper + '_' + string(index);
  }
  function legacyEvent(uid,date,paper,index) {
    let c = claimPath(uid + '_' + date + '_' + paper);
    return exists(c) && legacyEventDay(uid,get(c).data.attemptId,paper,index,date);
  }
  function legacyEventDay(uid,attempt,paper,index,date) {
    let e = eventPath(uid + '_' + attempt + '_' + paper + '_' + string(index));
    return exists(e) && get(e).data.activityDay == date;
  }
  function legacyRepeat(uid,date,paper,index) {
    let k = questionKey(paper,index);
    return k == 'past2024_22'
      ? legacyEvent(uid,date,'past2024',22) || legacyEvent(uid,date,'questions',14)
      : k == 'questions_7'
        ? legacyEvent(uid,date,'questions',7) || legacyEvent(uid,date,'paper1',9)
        : legacyEvent(uid,date,paper,index);
  }
  function earnedInPeriod(e,period) {
    return period.outlet == e.outlet && period.since <= e.earnedAt && e.earnedAt < period.until;
  }
  function validOutletReceipt(e,person) {
    let epoch=timestamp.date(1970,1,1);
    return (e.earnedAt >= person.get('outletSince',epoch)
      ? e.outlet == person.outlet && !('outletPeriod' in e)
      : earnedInPeriod(e,person.outletHistory[e.outletPeriod]))
      && e.get('outletCredit',e.points) == (e.earnedAt < person.get('outletResetTimes',{}).get(e.outlet,epoch) ? 0 : e.points);
  }
  match /scoreEvents/{id} {
    allow get: if logged() && id.matches('^' + request.auth.uid + '_.*');
    allow list: if false;
    allow create: if logged()
      && request.resource.data.keys().hasOnly(['uid','paper','index','selected','points','remaining','attemptId','dayKey','weekKey','monthKey','outlet','outletWeekKey','outletMonthKey','activityDay','earnedAt','outletCredit','outletPeriod'])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.paper in ['past2024','questions','paper1','paper2','paper3']
      && request.resource.data.index is int && request.resource.data.index >= 0
      && request.resource.data.index < (request.resource.data.paper == 'past2024' ? 29 : request.resource.data.paper == 'questions' ? 40 : request.resource.data.paper == 'paper3' ? 45 : 50)
      && request.resource.data.selected is int && request.resource.data.selected >= -1 && request.resource.data.selected <= 5
      && request.resource.data.remaining is int && request.resource.data.remaining >= 0 && request.resource.data.remaining <= 60
      && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 70
      && validOutletReceipt(request.resource.data,get(userPath(request.auth.uid)).data)
      && request.resource.data.outletWeekKey == request.resource.data.weekKey + '__' + request.resource.data.outlet
      && request.resource.data.outletMonthKey == request.resource.data.monthKey + '__' + request.resource.data.outlet
      && request.resource.data.earnedAt is timestamp
      && request.resource.data.earnedAt > get(userPath(request.auth.uid)).data.get('scoreResetAt',timestamp.date(1970,1,1))
      && request.resource.data.weekKey == slWeek(request.resource.data.earnedAt)
      && request.resource.data.monthKey == slMonth(request.resource.data.earnedAt)
      && request.resource.data.activityDay == slDate(request.resource.data.earnedAt)
      && request.resource.data.earnedAt <= request.time + duration.value(5,'m')
      && request.resource.data.earnedAt >= request.time - duration.value(72,'h')
      && request.resource.data.dayKey == request.resource.data.activityDay
      && request.resource.data.attemptId is string && request.resource.data.attemptId.size() >= 12 && request.resource.data.attemptId.size() <= 100
      && id == request.resource.data.uid + '_q_' + request.resource.data.activityDay + '_' + questionKey(request.resource.data.paper,request.resource.data.index)
      && !legacyRepeat(request.auth.uid,request.resource.data.activityDay,request.resource.data.paper,request.resource.data.index)
      && exists(keyPath(request.resource.data.paper + '_' + string(request.resource.data.index)))
      && request.resource.data.points == (request.resource.data.selected == get(keyPath(request.resource.data.paper + '_' + string(request.resource.data.index))).data.answer ? 10 + request.resource.data.remaining : 0)
      && getAfter(userPath(request.auth.uid)).data.lastEventId == id;
    allow update, delete: if false;
  }
  match /savedSessions/{uid} {
    allow read, delete: if mine(uid);
    allow create, update: if mine(uid)
      && request.resource.data.keys().hasOnly(['uid','snapshot','updatedAt'])
      && request.resource.data.uid == uid
      && request.resource.data.snapshot is map
      && request.resource.data.snapshot.keys().hasAll(['currentPaper','qIndex','questions','sessionAnswers']);
  }
  match /outletRequests/{id} {
    allow read: if logged() && (admin() || resource.data.uid == request.auth.uid);
    allow create: if logged()
      && request.resource.data.keys().hasOnly(['uid','from','to','status','createdAt'])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.from == get(userPath(request.auth.uid)).data.outlet
      && validOutlet(request.resource.data.to)
      && request.resource.data.to != request.resource.data.from
      && request.resource.data.status == 'pending';
    allow update: if admin()
      && resource.data.status == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
      && request.resource.data.status in ['approved','rejected']
      && request.resource.data.reviewedBy == request.auth.uid;
    allow delete: if false;
  }
  match /seenMonthly/{id} {
    allow read: if logged() && id.matches('^' + request.auth.uid + '_.*');
    allow create: if logged() && request.resource.data.uid == request.auth.uid && request.resource.data.month is string;
    allow update,delete: if false;
  }
 }
}